{
  "manifest_version": 3,
  "name": "PDF Sign",
  "version": "1.0.0",
  "description": "Annotate and sign PDF files directly in your browser",

  "action": {
    "default_title": "Open PDF Sign",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ]
}
